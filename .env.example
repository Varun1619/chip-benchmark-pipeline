# Copy to .env before running the stack: cp .env.example .env
# Values below are the defaults used by docker compose.

# Redpanda / Kafka
# Inside the compose network use redpanda:9092.
# From the host (running a service directly) use localhost:19092.
REDPANDA_BROKERS=redpanda:9092
BENCHMARK_TOPIC=benchmark.runs.raw

# Synthetic benchmark producer
PRODUCER_EVENTS_PER_SECOND=25
PRODUCER_SEED=42
# 0 keeps producing until the container is stopped.
PRODUCER_MAX_EVENTS=0

# History generated at startup, so rolling baselines have data immediately.
# 45 days covers every driver version in the rollout schedule.
PRODUCER_BACKFILL_DAYS=45
PRODUCER_BACKFILL_RUNS_PER_DAY=400

# Storage. Mounted as /data inside every container.
DATA_ROOT=/data
SPARK_TRIGGER_INTERVAL=30 seconds

# Streaming checkpoints. compose points this at a container volume, because the
# metadata log is compacted often and a host bind mount makes that slow.
# Leave unset to keep checkpoints under DATA_ROOT.
CHECKPOINT_ROOT=/checkpoints

# Host ports. Change these if something already listens on the default.
# Container side ports never change, so nothing else has to move with them.
REDPANDA_HOST_PORT=19092
REDPANDA_ADMIN_PORT=19644
SPARK_UI_PORT=4040
CONSOLE_PORT=8080

# Dashboard
DASHBOARD_PORT=8501

LOG_LEVEL=INFO
