# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment
.env
.env.local

# Data lake, warehouse and streaming checkpoints.
# The sample snapshot committed for the hosted dashboard is the only exception.
data/*
!data/.gitkeep
!data/sample/
!data/sample/**
# The directory has to exist for DuckDB to create the warehouse file in it,
# so the placeholder is tracked while the database itself is not.
!data/warehouse/
data/warehouse/*
!data/warehouse/.gitkeep

# DuckDB artifacts written outside data/
*.duckdb
*.duckdb.wal

# Spark
spark-warehouse/
metastore_db/
derby.log
logs/

